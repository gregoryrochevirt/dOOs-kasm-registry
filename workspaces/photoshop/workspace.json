{
  "description": "Adobe Photoshop.",
  "docker_registry": "https://gitea.gregoryroche.fr",
  "image_src": "photoshop.png",
  "enabled": true,
  "image_type": "Container",
  "cores": 4,
  "memory": 5000,
  "require_gpu": false,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "photoshop",
    "environment": {
      "SYSDARKTHEME": "true",
      "SYSFILES":"true"
    }
  },
  "categories": [
    "3d",
    "adobe",
    "doos"
  ],
  "friendly_name": "Photoshop",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "gitea.gregoryroche.fr/greg/photoshop:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "develop",
        "2021"
      ]
    }
  ]
}
