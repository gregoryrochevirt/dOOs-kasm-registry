{
  "description": "Devolution Remote Desktop Manager.",
  "docker_registry": "https://gitea.gregoryroche.fr",
  "image_src": "remotedesktopmanager.png",
  "enabled": true,
  "image_type": "Container",
  "cores": 4,
  "memory": 5000,
  "require_gpu": false,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "rdm",
    "environment": {
      "SYSDARKTHEME": "true",
      "SYSFILES":"true"
    }
  },
  "exec_config": {
    "first_launch": {
      "user": "root",
      "cmd": "bash -c 'echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  },
  "categories": [
    "tools",
    "remote",
    "greg"
  ],
  "friendly_name": "remotedesktopmanager",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "gitea.gregoryroche.fr/greg/rdm:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "develop",
        "2024.3.2.9",
        "latest"
      ]
    }
  ]
}
