{
  "description": "thunderbird mail client.",
  "docker_registry": "https://harbor.vstudy.eu",
  "image_src": "thunderbird.png",
  "enabled": true,
  "image_type": "Container",
  "cores": 4,
  "memory": 5000,
  "require_gpu": false,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "thunderbird",
    "environment": {
      "SYSDARKTHEME": "true",
      "SYSFILES":"true"
    }
  },
  "categories": [
    "mail"
  ],
  "friendly_name": "thunderbird",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "harbor.vstudy.eu/kasm_workspace/thunderbird:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "develop",
        "latest"
      ]
    }
  ]
}
