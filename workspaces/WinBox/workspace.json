{
  "description": "Mikrotik Winbox 4.",
  "docker_registry": "https://gitea.vstudy.eu",
  "image_src": "Winbox.png",
  "enabled": true,
  "image_type": "Container",
  "cores": 4,
  "memory": 5000,
  "require_gpu": false,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "winbox",
    "environment": {
      "SYSDARKTHEME": "true",
      "SYSFILES":"true",
      "CONNECTTO": "192.168.0.111:12345",
      "USERMANE": "changeme",
      "PASSWORD": "changeme"
    }
  },
  "categories": [
    "tools",
    "network",
    "doos"
  ],
  "friendly_name": "Winbox",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "gitea.vstudy.eu/greg/winbox:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "develop",
        "latest"
      ]
    }
  ]
}
