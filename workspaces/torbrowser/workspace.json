{
  "description": "torbrowser.",
  "docker_registry": "https://harbor.vstudy.eu",
  "image_src": "torbrowser.png",
  "enabled": true,
  "image_type": "Container",
  "cores": 4,
  "memory": 5000,
  "require_gpu": false,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "torbrowser",
    "environment": {
      "SYSDARKTHEME": "true",
      "SYSFILES":"true"
    }
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "browser"
  ],
  "friendly_name": "torbrowser",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "harbor.vstudy.eu/kasm_workspace/torbrowser:latest",
      "uncompressed_size_mb": 0,
      "available_tags": [
        "develop",
        "latest"
      ]
    }
  ]
}
